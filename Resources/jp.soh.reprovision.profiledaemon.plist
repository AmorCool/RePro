<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- RePro 描述文件安装守护进程（RootHide 专用）
	
	     由 launchd 以 root 身份在系统级上下文启动，
	     完全在 RootHide App 的 jbroot namespace 外面运行。
	     能看到真实 rootfs、写真实 /var/Managed Preferences/mobile、
	     MCProfileConnection 直连真实 profiled。
	     
	     这是解决 RootHide 下 installd 0xe8008015 的最终方案：
	       App 的 in-process MC 被 RootHide 重定向到 overlay（假成功），
	       App posix_spawn 的 helper 继承 App namespace（写的也是 overlay），
	       只有 launchd 拉起的进程才不受 namespace 影响。 -->

	<key>Label</key>
	<string>jp.soh.reprovision.profiledaemon</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/repro-profiledaemon</string>
	</array>

	<key>UserName</key>
	<string>root</key>

	<!-- 开机即启动、崩溃自动重启 -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<!-- 交互式进程类型（允许 runloop 运行） -->
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
</dict>
</plist>
