<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- repro-helper 按需 root 助手（RootHide 专属）

	     RootHide 默认把所有越狱二进制关进沙箱，因此比通用版多一组
	     no-sandbox / storage.* 权限（照搬 roothide/Developer 官方
	     roothide.entitlements 模板）。
	     helper 是一次性进程，不需要 launchd / mach-service / 后台断言。 -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.skip-library-validation</key>
	<true/>

	<!-- posix_spawn 调 /usr/bin/killall -HUP profiled -->
	<key>com.apple.private.posix-spawn</key>
	<true/>

	<!-- 写入系统描述文件库（真实路径，不是 jbroot overlay） -->
	<key>com.apple.private.storage-managedpreferences</key>
	<true/>

	<!-- 经 MCProfileConnection XPC 把描述文件注册进 profiled 的「本地 provisioning 库」
	     （只给 profiled-access，绝不给 profiled.provisioningprofiles 数组授权）。
	     关键认知（v1.1.19 踩坑）：带上 provisioningprofiles 数组（含 Installation 授权）
	     会让 profiled 把 profile 注册进 **managed（MDM）库**，而 installd 的
	     AllowInstallLocalProvisioned 校验查的是「本地库」→ 0xe8008015。
	     能正常工作的 rootless test源码 即只持 profiled-access（platform-application 同款），
	     调 MC 时 managingProfileIdentifier 传 nil、落进本地库。本 helper 与之对齐。 -->
	<key>com.apple.managedconfiguration.profiled-access</key>
	<true/>

	<!-- 修复当前插件联网（fix-cellular）：CoreTelephony 私有 C 函数需要 fine-grained 授权，
	     否则 _CTServerConnectionSetCellularUsagePolicy 全返回 2（CommCenter XPC 拒绝），
	     246/246 应用策略无法写入。补上后返回 0，用户实测开关可恢复联网。 -->
	<key>com.apple.CommCenter.fine-grained</key>
	<array>
		<string>cellular-plan</string>
		<string>data-usage</string>
		<string>data-allowed</string>
		<string>data-allowed-write</string>
		<string>preferences-write</string>
	</array>
</dict>
</plist>
