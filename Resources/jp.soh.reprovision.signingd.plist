<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>jp.soh.reprovision.signingd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/repro-signingd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- v1.1.150 方案B：崩溃后至少间隔 30 秒才允许再次拉起。
	     防「崩溃→立即拉起→再崩溃」循环反复执行 launchd 注入逻辑
	     （roothide launchdhook 每次拉起都会在 launchd 里跑一轮）。 -->
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>UserName</key>
	<string>root</string>
	<key>POSIXSpawnType</key>
	<string>Interactive</string>
</dict>
</plist>
