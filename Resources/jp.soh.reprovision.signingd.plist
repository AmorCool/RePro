<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>jp.soh.reprovision.signingd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/repro-signingd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- v1.1.155 短命化：去掉 KeepAlive，改由 StartCalendarInterval 每小时（第 0 分钟）拉起一次。
	     根因（SSH 实测）：iOS 17 launchd 的 efficiency 管理会对「长驻但 IPC 稀疏」的
	     守护进程判 immediate reason=inefficient 并 SIGKILL(-9)；KeepAlive=true 会造成
	     「被杀→立刻拉起→再被杀」风暴（实测 daemon 活不过 5 秒，自动续签调度瘫痪；
	     ProcessType=Background 也绕不开该判定）。
	     短命模式：进程启动→一轮到期检查→需要则唤醒 App 等其完成→退出，
	     被杀无意义（本来就要退），RootHide XPC 拦截器常驻泄漏也彻底无累积机会。
	     设备深睡错过调度时，launchd 会在唤醒后立即补执行。 -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<!-- v1.1.150 方案B：崩溃后至少间隔 30 秒才允许再次拉起。
	     防「崩溃→立即拉起→再崩溃」循环反复执行 launchd 注入逻辑
	     （roothide launchdhook 每次拉起都会在 launchd 里跑一轮）。 -->
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>UserName</key>
	<string>root</string>
	<!-- v1.1.152：移除 POSIXSpawnType=Interactive 改默认 Background 类型。
	     Interactive spawn 在 iOS 17 launchd 下容易被判 "inefficient" 主动 SIGTERM；
	     实测在 iPhone 11 (4GB) 上 3 个 daemon 全部立即被杀 + 指数退避越拉越慢。
	     Background 类型让 launchd 知道这是后台守护，不强制要求"持续产生 IPC"。 -->
	<!-- v1.1.152：显式声明 ProcessType=Background + MemoryLimit=50MB。
	     默认 daemon category jetsam memory limit 仅 6MB（iPhone 11 实测），
	     一旦 Roothide 容器内 minor 波动就超限被 jetsam 杀；
	     提到 50MB 给正常 rootfs 守护足够空间（纯 C daemon 峰值 < 30MB）。 -->
	<key>ProcessType</key>
	<string>Background</string>
	<key>MemoryLimit</key>
	<integer>50</integer>
</dict>
</plist>
