<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- repro-helper 按需 root 助手（rootful / Dopamine rootless 通用）

         它只做两件事：以 root 复制文件、把描述文件写进
         /var/Managed Preferences/mobile 并踢一下 profiled。
         做完立刻退出，所以不需要 launchd、mach-service、网络、Keychain
         这些常驻守护进程才用得上的权限。 -->

    <!-- 平台二进制，绕过 AMFI 对非 App Store 签名的限制 -->
    <key>platform-application</key>
    <true/>

    <!-- 不进沙箱容器，才能看到真实的 /var/Managed Preferences -->
    <key>com.apple.private.security.no-container</key>
    <true/>

    <!-- posix_spawn 调 /usr/bin/killall -HUP profiled -->
    <key>com.apple.private.posix-spawn</key>
    <true/>

    <!-- 写入系统描述文件库 -->
    <key>com.apple.private.storage-managedpreferences</key>
    <true/>

    <!-- 经 MCProfileConnection XPC 把描述文件注册进 profiled 真实库。
         helper 也调用 MC XPC（installProvisioningProfileAtPath 主路径），
         profiled 要求调用方持有此数组授权（含 Installation），否则 MCXPCErrorDomain
         Code=39000。helper 由 ldid 签名，可直接注入。 -->
    <key>com.apple.managedconfiguration.profiled.provisioningprofiles</key>
    <array>
        <string>Read</string>
        <string>Installation</string>
        <string>Removal</string>
    </array>

    <!-- 允许连接 profiled XPC（MCProfileConnection 前提）。 -->
    <key>com.apple.managedconfiguration.profiled-access</key>
    <true/>
</dict>
</plist>
