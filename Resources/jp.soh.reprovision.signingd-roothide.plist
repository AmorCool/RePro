<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>jp.soh.reprovision.signingd</string>
	<key>ProgramArguments</key>
	<array>
		<!-- ★ v1.1.65 关键修复：RootHide 下必须设这两个环境变量，否则 RootHide 会在运行时
		     剥离 com.apple.backboardd.launchapplications 等私有 entitlement，
		     backboardd 拒绝启动 App（SBSLaunch 返回 7），自动续签永远拉不起 App。
		     这是参考 ReProvision-Reborn roothide 包 reprovisiond 的 LaunchDaemon 写法。 -->
		<string>/usr/bin/env</string>
		<string>_MSSafeMode=1</string>
		<string>_SafeMode=1</string>
		<string>/usr/libexec/repro-signingd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- v1.1.155 短命化：去掉 KeepAlive，改由 StartCalendarInterval 每 5 分钟拉起一次。
	     见 Resources/jp.soh.reprovision.signingd.plist 注释（iOS 17 "inefficient"
	     SIGKILL 杀循环 → 短命进程绕开 + RootHide 常驻泄漏无累积机会）。 -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>5</integer>
	</dict>
	<!-- v1.1.150 方案B：崩溃后至少间隔 30 秒才允许再次拉起。
	     防「崩溃→立即拉起→再崩溃」循环反复执行 launchd 注入逻辑
	     （roothide launchdhook 每次拉起都会在 launchd 里跑一轮）。 -->
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>UserName</key>
	<string>root</string>
	<!-- v1.1.152：见 Resources/jp.soh.reprovision.signingd.plist 注释
	     （移除 Interactive 改 Background + 加 MemoryLimit=50MB 防 iOS 17
	      launchd "inefficient" 判定 + 6MB jetsam 限额过严）。 -->
	<key>ProcessType</key>
	<string>Background</string>
	<key>MemoryLimit</key>
	<integer>50</integer>
</dict>
</plist>
