<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Daemon entitlements（所有环境通用） -->
    <!-- 以 root 身份运行，无沙盒限制 -->

    <!-- 平台应用 -->
    <key>platform-application</key>
    <true/>

    <!-- 无容器/无沙盒 -->
    <key>com.apple.private.security.no-container</key>
    <true/>

    <!-- posix_spawn 启动 zsign 子进程 -->
    <key>com.apple.private.posix-spawn</key>
    <true/>

    <!-- Keychain 访问 -->
    <key>keychain-access-groups</key>
    <array>
        <string>com.reprovision.*</string>
    </array>

    <!-- 网络客户端（Apple ID 认证、profile 下载） -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- MachService 监听（接收前端连接） -->
    <key>com.apple.security.cs.mach-service</key>
    <true/>

    <!-- launchd 通信 -->
    <key>com.apple.private.launchd</key>
    <true/>

    <!-- 写入系统 profile 目录 -->
    <key>com.apple.private.storage-managedpreferences</key>
    <true/>
</dict>
</plist>
