#!/bin/bash
#
# ReProvision (rootful) postinst — 照搬原版 ReProvision 源码
#

# Rootful layout: binaries live at the real root, not under /var/jb.
JB_PREFIX=""
PLIST="${JB_PREFIX}/Library/LaunchDaemons/jp.soh.reprovisiond.plist"

function finish() {
	f="${1}"
	[[ -z "${f}" || -z "${CYDIA}" ]] && return
	cydia=(${CYDIA})
	[[ ${cydia[1]} -eq 1 ]] || return
	echo "finish:${f}" >&${cydia[0]}
}

# Clear Inbox folder
if [ -d "/var/mobile/Library/Application Support/Containers/jp.soh.reprovision.ios/Documents/Inbox" ]; then
	rm -rf "/var/mobile/Library/Application Support/Containers/jp.soh.reprovision.ios/Documents/Inbox"
fi

# Locate launchctl
LAUNCHCTL=""
for c in "/bin/launchctl" "/usr/bin/launchctl"; do
	if [ -x "$c" ]; then LAUNCHCTL="$c"; break; fi
done

# Handle the daemon
echo "(Re)-loading daemon..."

if [ -f "$PLIST" ]; then
	chown root:wheel "$PLIST" 2>/dev/null || true
	chmod 644 "$PLIST" 2>/dev/null || true
fi

DAEMON_BIN="${JB_PREFIX}/usr/libexec/reprovisiond"
if [ -f "$DAEMON_BIN" ]; then
	chown root:wheel "$DAEMON_BIN" 2>/dev/null || true
	chmod 0755 "$DAEMON_BIN" 2>/dev/null || true
fi

ZSIGN_BIN="${JB_PREFIX}/usr/local/bin/zsign"
if [ -f "$ZSIGN_BIN" ]; then
	chown root:wheel "$ZSIGN_BIN" 2>/dev/null || true
	chmod 0755 "$ZSIGN_BIN" 2>/dev/null || true
fi

# App 二进制权限
APP_BIN="${JB_PREFIX}/Applications/RePro.app/RePro"
if [ -f "$APP_BIN" ]; then
	chmod 0755 "$APP_BIN" 2>/dev/null || true
fi

if [ -n "$LAUNCHCTL" ]; then
	BOOT_LOG="${JB_PREFIX}/tmp/reprovision_bootstrap.log"
	: > "$BOOT_LOG" 2>/dev/null || BOOT_LOG="/tmp/reprovision_bootstrap.log"
	{
		echo "== bootout/unload =="
		"$LAUNCHCTL" bootout system "$PLIST" 2>&1 || "$LAUNCHCTL" unload "$PLIST" 2>&1 || true
		echo "== bootstrap/load =="
		"$LAUNCHCTL" bootstrap system "$PLIST" 2>&1 || "$LAUNCHCTL" load "$PLIST" 2>&1 || true
		echo "== enable =="
		"$LAUNCHCTL" enable system/jp.soh.reprovisiond 2>&1 || true
		echo "== kickstart =="
		"$LAUNCHCTL" kickstart -k system/jp.soh.reprovisiond 2>&1 || true
	} >> "$BOOT_LOG" 2>&1
fi

# Reload application cache via uicache
echo "Reloading application cache"
UICACHE=""
for c in "/usr/bin/uicache" "/bin/uicache"; do
	if [ -x "$c" ]; then UICACHE="$c"; break; fi
done
if [ -n "$UICACHE" ]; then
	"$UICACHE" -p "/Applications/RePro.app" || "$UICACHE" -a || true
fi

echo "Do, or do not. There is no try."
finish restart
exit 0
