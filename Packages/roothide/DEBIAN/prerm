#!/bin/bash
set -e

# ReSign RootHide 包 prerm
# 停止 profiledaemon（卸载前必须先 unload，否则二进制被删后 launchd 会报错）

echo "[ReSign] RootHide prerm 开始 $(date)"

# 停止 profiledaemon LaunchDaemon
for c in /bin/launchctl /usr/bin/launchctl; do
	if [ -x "$c" ]; then
		"$c" bootout system /Library/LaunchDaemons/cn.analy.resign.profiledaemon.plist 2>/dev/null || \
		"$c" unload /Library/LaunchDaemons/cn.analy.resign.profiledaemon.plist 2>/dev/null || true
		"$c" bootout system /Library/LaunchDaemons/cn.analy.resign.signingd.plist 2>/dev/null || \
		"$c" unload /Library/LaunchDaemons/cn.analy.resign.signingd.plist 2>/dev/null || true
		break
	fi
done
pkill -x repro-profiledaemon 2>/dev/null || true
pkill -x repro-signingd 2>/dev/null || true
echo "[ReSign] profiledaemon / signingd 已停止"

# 清理残留数据（日志/临时文件，升级时也可清）
rm -rf /var/mobile/Library/Logs/RePro 2>/dev/null || true
rm -rf /var/mobile/Library/Resignvision 2>/dev/null || true
rm -f /var/mobile/Documents/ReProvisionDebug.txt 2>/dev/null || true
rm -rf /tmp/reprovision_*.log 2>/dev/null || true
# 🔴 v2.1.14：升级（upgrade）时绝不清理 Resign 目录！里面是 credentials.cache /
# anisette.cache（凭据+Anisette 缓存），清了 daemon 就报「凭据缓存缺失」，
# 之前每次升级丢凭据（真机 19:17/23:00 两次实锤）。只有真卸载（remove）才清。
# dpkg prerm 传参：remove | upgrade <new-version>
if [ "$1" = "remove" ]; then
	# v1.1.184：RootHide 下命名空间里的 /var/mobile/Library/Resign 是空壳，
	# 真实 IPC 目录在 /rootfs/var/mobile/Library/Resign —— 多候选路径全部清一遍。
	for d in \
		/var/mobile/Library/Resign \
		/rootfs/var/mobile/Library/Resign \
		/var/jb/rootfs/var/mobile/Library/Resign \
		/var/containers/Bundle/Application/.jbroot-*/var/mobile/Library/Resign; do
		rm -rf "$d" 2>/dev/null || true
	done
	echo "[ReSign] 残留数据已清理（含真实 rootfs 的 RePro 目录）"
else
	echo "[ReSign] 升级模式：保留凭据/Anisette 缓存（/var/mobile/Library/Resign）"
fi

echo "[ReSign] RootHide prerm 完成 $(date)"
exit 0
