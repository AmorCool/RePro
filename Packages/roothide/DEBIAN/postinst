#!/bin/bash
# ReProvision RootHide 包 postinst
# RootHide 布局：dpkg 自动映射到 jbroot，/ = jbroot

DAEMON_PLIST="/Library/LaunchDaemons/jp.soh.reprovisiond.plist"
DAEMON_BIN="/usr/libexec/reprovisiond"
ZSIGN_BIN="/usr/local/bin/zsign"
LOG_FILE="/tmp/reprovision_bootstrap.log"

echo "[RePro] RootHide postinst 开始 $(date)" > "$LOG_FILE"

# === 环境检测 ===
{
    echo "[RePro] 当前用户: $(whoami), uid: $(id -u)"
    echo "[RePro] RootHide 检测: $(test -f /var/jb/.roothide_version && echo YES || echo NO)"
    echo "[RePro] plist 路径: $DAEMON_PLIST"
    echo "[[RePro]] daemon 路径: $DAEMON_BIN"
    echo "[RePro] plist 存在: $(test -f "$DAEMON_PLIST" && echo YES || echo NO)"
    echo "[RePro] daemon 存在: $(test -f "$DAEMON_BIN" && echo YES || echo NO)"
} >> "$LOG_FILE" 2>&1

# === 权限修复 ===
chmod 0755 "$DAEMON_BIN" 2>>"$LOG_FILE" || true
chmod 0755 "$ZSIGN_BIN" 2>>"$LOG_FILE" || true

# 验证二进制架构
if [ -f "$DAEMON_BIN" ]; then
    file "$DAEMON_BIN" >> "$LOG_FILE" 2>&1
    # 检查是否是 arm64 Mach-O
    if ! file "$DAEMON_BIN" | grep -q "Mach-O.*arm64"; then
        echo "[RePro] WARNING: daemon 二进制不是 arm64!" >> "$LOG_FILE"
    fi
fi

# === 确保 log 目录存在 ===
mkdir -p /var/mobile/Library/Logs/RePro 2>/dev/null
chown mobile:mobile /var/mobile/Library/Logs/RePro 2>/dev/null || true

# === 启动守护进程 ===
start_daemon() {
    local method="$1"
    echo "[RePro] 尝试启动方式: $method" >> "$LOG_FILE"

    case "$method" in
        bootstrap)
            launchctl bootstrap system "$DAEMON_PLIST" 2>>"$LOG_FILE"
            ;;
        load)
            launchctl load -w "$DAEMON_PLIST" 2>>"$LOG_FILE"
            ;;
        kickstart)
            launchctl kickstart system/jp.soh.reprovisiond 2>>"$LOG_FILE"
            ;;
        direct)
            # 直接运行（调试用，不经过 launchd）
            "$DAEMON_BIN" &
            ;;
    esac
    return $?
}

verify_daemon() {
    # 等待 daemon 启动
    sleep 1

    # 方式1: 检查 pid
    local pid=$(launchctl print system/jp.soh.reprovisiond 2>/dev/null | grep "pid=" | head -1 | cut -d= -f2)
    if [ -n "$pid" ] && [ "$pid" -gt 0 ] 2>/dev/null; then
        echo "[RePro] daemon 运行中, PID=$pid" >> "$LOG_FILE"
        return 0
    fi

    # 方式2: 检查进程名
    if pgrep -x reprovisiond > /dev/null 2>&1; then
        local found_pid=$(pgrep -x reprovisiond | head -1)
        echo "[RePro] daemon 运行中 (pgrep), PID=$found_pid" >> "$LOG_FILE"
        return 0
    fi

    echo "[RePro] daemon 未在运行!" >> "$LOG_FILE"
    return 1
}

if [ -f "$DAEMON_PLIST" ] && [ -f "$DAEMON_BIN" ]; then
    # 尝试多种启动方式
    for method in bootstrap load kickstart; do
        if start_daemon "$method"; then
            sleep 1
            if verify_daemon; then
                echo "[RePro] 守护进程启动成功 ($method)" >> "$LOG_FILE"
                break
            fi
        else
            echo "[RePro] $method 失败，尝试下一种..." >> "$LOG_FILE"
        fi
    done
else
    echo "[RePro] 错误: 缺少必要文件" >> "$LOG_FILE"
    [ ! -f "$DAEMON_PLIST" ] && echo "[RePro]   缺少: $DAEMON_PLIST" >> "$LOG_FILE"
    [ ! -f "$DAEMON_BIN" ] && echo "[RePro]   缺少: $DAEMON_BIN" >> "$LOG_FILE"
fi

# === 刷新图标缓存 ===
uicache -p /Applications/RePro.app 2>/dev/null || true

# === 最终状态 ===
{
    echo "[RePro] ====== postinst 完成 $(date) ======"
    echo "[RePro] 最终状态:"
    launchctl print system/jp.soh.reprovisiond 2>/dev/null | head -10 || echo "[RePro] 无法查询 launchd 状态"
    ps aux | grep reprovisiond | grep -v grep || echo "[RePro] 进程列表中未找到 reprovisiond"
} >> "$LOG_FILE" 2>&1
