#!/bin/bash
#
# RePro (RootHide) postinst
#
# RootHide 下 App 进程在 jbroot namespace 内，其 MCProfileConnection XPC 与
# /var/Managed Preferences/mobile 写入都被重定向到 overlay（假成功），installd
# 校验时找不到真实 profile -> 0xe8008015。故描述文件安装改由 repro-profiledaemon
# （launchd 在系统级上下文启动，不在 App namespace 内）完成：写真实路径 +
# MC 直连真实 profiled。App 经 notify IPC 触发。
#
# IPA 搬运仍由 repro-helper（setuid，App posix_spawn 按需拉起）完成。
#
# RootHide 的 dpkg 维护脚本运行在 vroot shell 中——脚本里的 "/" 就是 jbroot，
# 下面这些标准根路径会被自动映射到 <jbroot>/... ，直接用即可。
#

function finish() {
	f="${1}"
	[[ -z "${f}" || -z "${CYDIA}" ]] && return
	cydia=(${CYDIA})
	[[ ${cydia[1]} -eq 1 ]] || return
	echo "finish:${f}" >&${cydia[0]}
}

# Clear Inbox folder（jbroot 路径，vroot shell 下直接可用）
if [ -d "/var/mobile/Library/Application Support/Containers/jp.soh.reprovision.ios/Documents/Inbox" ]; then
	rm -rf "/var/mobile/Library/Application Support/Containers/jp.soh.reprovision.ios/Documents/Inbox"
fi

# 从旧版本（带 reprovisiond 守护进程或旧版 profiledaemon）升级时的兜底清理：
for c in /bin/launchctl /usr/bin/launchctl; do
	if [ -x "$c" ]; then
		for domain in "gui/501" "user/501" "system"; do
			"$c" bootout "$domain/jp.soh.reprovisiond" 2>/dev/null || true
			"$c" bootout "$domain/jp.soh.reprovision.profiledaemon" 2>/dev/null || true
		done
		break
	fi
done
pkill -x reprovisiond 2>/dev/null || true
pkill -x repro-profiledaemon 2>/dev/null || true

# 按需 root helper：必须 root:wheel + setuid（4755），
# 否则 mobile 身份的 App 拉起它时拿不到 root。
HELPER="/usr/libexec/repro-helper"
if [ -f "$HELPER" ]; then
	chown root:wheel "$HELPER" 2>/dev/null || true
	chmod 4755 "$HELPER" 2>/dev/null || true
	echo "root helper: $(ls -l "$HELPER")"
fi

# 描述文件安装守护进程：root:wheel + 0755（不需要 setuid，launchd 已以 root 启动）
DAEMON="/usr/libexec/repro-profiledaemon"
if [ -f "$DAEMON" ]; then
	chown root:wheel "$DAEMON" 2>/dev/null || true
	chmod 0755 "$DAEMON" 2>/dev/null || true
	echo "profile daemon: $(ls -l "$DAEMON")"
fi

ZSIGN="/usr/local/bin/zsign"
if [ -f "$ZSIGN" ]; then
	chown root:wheel "$ZSIGN" 2>/dev/null || true
	chmod 0755 "$ZSIGN" 2>/dev/null || true
fi

# App 二进制权限
APP_BIN="/Applications/RePro.app/RePro"
if [ -f "$APP_BIN" ]; then
	chmod 0755 "$APP_BIN" 2>/dev/null || true
fi

# 加载 profiledaemon LaunchDaemon（系统级上下文，不受 App namespace 影响）
PLIST="/Library/LaunchDaemons/jp.soh.reprovision.profiledaemon.plist"
LAUNCHCTL=""
for c in /bin/launchctl /usr/bin/launchctl; do
	if [ -x "$c" ]; then LAUNCHCTL="$c"; break; fi
done

if [ -n "$LAUNCHCTL" ] && [ -f "$PLIST" ]; then
	chown root:wheel "$PLIST" 2>/dev/null || true
	chmod 644 "$PLIST" 2>/dev/null || true
	echo "Loading profiledaemon..."
	"$LAUNCHCTL" bootout system "$PLIST" >/dev/null 2>&1 || "$LAUNCHCTL" unload "$PLIST" >/dev/null 2>&1 || true
	"$LAUNCHCTL" bootstrap system "$PLIST" >/dev/null 2>&1 || "$LAUNCHCTL" load "$PLIST" >/dev/null 2>&1 || true
	echo "profiledaemon launched (system context, outside App namespace)"
else
	echo "WARNING: 无法加载 profiledaemon（launchctl 或 plist 不存在）"
fi

# Reload application cache（uicache 是 bootstrap 工具，认 jbroot 路径）
echo "Reloading application cache"
UICACHE=""
for c in /usr/bin/uicache /bin/uicache; do
	if [ -x "$c" ]; then UICACHE="$c"; break; fi
done
if [ -n "$UICACHE" ]; then
	"$UICACHE" -p "/Applications/RePro.app" 2>/dev/null || "$UICACHE" -a 2>/dev/null || true
fi

echo "Do, or do not. There is no try."
finish restart
exit 0
