#!/bin/bash
set -e

# ReProvision RootHide 包 postinst
# RootHide 布局：dpkg 自动映射到 jbroot，/ = jbroot

DAEMON_PLIST="/Library/LaunchDaemons/jp.soh.reprovisiond.plist"
DAEMON_BIN="/usr/libexec/reprovisiond"
ZSIGN_BIN="/usr/local/bin/zsign"

echo "[RePro] RootHide postinst 开始 $(date)"

# 确保二进制文件可执行
chmod +x "$DAEMON_BIN" 2>/dev/null || true
chmod +x "$ZSIGN_BIN" 2>/dev/null || true

# 确保 log 目录存在
mkdir -p /var/mobile/Library/Logs/RePro
chown mobile:mobile /var/mobile/Library/Logs/RePro 2>/dev/null || true

# 写入调试日志
{
    echo "[RePro] postinst 时间: $(date)"
    echo "[RePro] plist: $DAEMON_PLIST (存在: $(test -f "$DAEMON_PLIST" && echo YES || echo NO))"
    echo "[RePro] daemon: $DAEMON_BIN (存在: $(test -f "$DAEMON_BIN" && echo YES || echo NO))"
    echo "[RePro] zsign: $ZSIGN_BIN (存在: $(test -f "$ZSIGN_BIN" && echo YES || echo NO))"
    echo "[RePro] 当前用户: $(whoami), uid: $(id -u)"
} > /tmp/reprovision_bootstrap.log 2>&1

# 启动守护进程（RootHide 下 / 就是 jbroot）
if [ -f "$DAEMON_PLIST" ]; then
    # 方式1: bootstrap（推荐）
    launchctl bootstrap system "$DAEMON_PLIST" 2>>/tmp/reprovision_bootstrap.log && {
        echo "[RePro] 守护进程启动成功 (bootstrap)" >> /tmp/reprovision_bootstrap.log
    } || {
        # 方式2: fallback 到 load（旧版兼容）
        launchctl load -w "$DAEMON_PLIST" 2>>/tmp/reprovision_bootstrap.log && {
            echo "[RePro] 守护进程启动成功 (load)" >> /tmp/reprovision_bootstrap.log
        } || {
            # 方式3: kickstart
            launchctl kickstart system/jp.soh.reprovisiond 2>>/tmp/reprovision_bootstrap.log
            echo "[RePro] 尝试 kickstart" >> /tmp/reprovision_bootstrap.log
        }
    }
else
    echo "[RePro] 错误: plist 不存在 $DAEMON_PLIST" >> /tmp/reprovision_bootstrap.log
fi

# 刷新图标缓存
uicache -p /Applications/RePro.app 2>/dev/null || true

echo "[RePro] RootHide postinst 完成 $(date)"
