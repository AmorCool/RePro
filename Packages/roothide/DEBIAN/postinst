#!/bin/bash
#
# RePro (RootHide) postinst
#
# 本版本已经没有常驻守护进程，所以过去那套「用 jbroot 工具把路径转成 rootfs
# 真实路径再喂给 launchctl bootstrap system」的复杂流程全部不需要了 ——
# 那正是 RootHide 下 daemon 起不来的根源。
#
# 需要 root 的两件事（跨沙箱复制 IPA、把描述文件写进真实的
# /var/Managed Preferences/mobile）改由 App 按需 posix_spawn 拉起
# repro-helper 完成，做完即退出。
#
# RootHide 的 dpkg 维护脚本运行在 vroot shell 中——脚本里的 "/" 就是 jbroot，
# 下面这些标准根路径会被自动映射到 <jbroot>/... ，直接用即可。
#

function finish() {
	f="${1}"
	[[ -z "${f}" || -z "${CYDIA}" ]] && return
	cydia=(${CYDIA})
	[[ ${cydia[1]} -eq 1 ]] || return
	echo "finish:${f}" >&${cydia[0]}
}

# Clear Inbox folder（jbroot 路径，vroot shell 下直接可用）
if [ -d "/var/mobile/Library/Application Support/Containers/jp.soh.reprovision.ios/Documents/Inbox" ]; then
	rm -rf "/var/mobile/Library/Application Support/Containers/jp.soh.reprovision.ios/Documents/Inbox"
fi

# 从旧版本（带 reprovisiond 守护进程）升级时的兜底清理：
# 旧包在 RootHide 下可能装在 gui/501、user/501 或 system 域，全试一遍。
for c in /bin/launchctl /usr/bin/launchctl; do
	if [ -x "$c" ]; then
		for domain in "gui/501" "user/501" "system"; do
			"$c" bootout "$domain/jp.soh.reprovisiond" 2>/dev/null || true
		done
		break
	fi
done
pkill -x reprovisiond 2>/dev/null || true

# 按需 root helper：必须 root:wheel + setuid（4755），
# 否则 mobile 身份的 App 拉起它时拿不到 root。
HELPER="/usr/libexec/repro-helper"
if [ -f "$HELPER" ]; then
	chown root:wheel "$HELPER" 2>/dev/null || true
	chmod 4755 "$HELPER" 2>/dev/null || true
	echo "root helper: $(ls -l "$HELPER")"
fi

ZSIGN="/usr/local/bin/zsign"
if [ -f "$ZSIGN" ]; then
	chown root:wheel "$ZSIGN" 2>/dev/null || true
	chmod 0755 "$ZSIGN" 2>/dev/null || true
fi

# App 二进制权限
APP_BIN="/Applications/RePro.app/RePro"
if [ -f "$APP_BIN" ]; then
	chmod 0755 "$APP_BIN" 2>/dev/null || true
fi

# Reload application cache（uicache 是 bootstrap 工具，认 jbroot 路径）
echo "Reloading application cache"
UICACHE=""
for c in /usr/bin/uicache /bin/uicache; do
	if [ -x "$c" ]; then UICACHE="$c"; break; fi
done
if [ -n "$UICACHE" ]; then
	"$UICACHE" -p "/Applications/RePro.app" 2>/dev/null || "$UICACHE" -a 2>/dev/null || true
fi

echo "Do, or do not. There is no try."
finish restart
exit 0
