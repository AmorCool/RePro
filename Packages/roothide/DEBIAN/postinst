#!/bin/bash
#
# RePro (RootHide) postinst
#
# RootHide 下 App 进程在 jbroot namespace 内，其 MCProfileConnection XPC 与
# /var/Managed Preferences/mobile 写入都被重定向到 overlay（假成功），installd
# 校验时找不到真实 profile -> 0xe8008015。故描述文件安装改由 repro-profiledaemon
# （launchd 在系统级上下文启动，不在 App namespace 内）完成：写真实路径 +
# MC 直连真实 profiled。App 经 notify IPC 触发。
#
# IPA 搬运仍由 repro-helper（setuid，App posix_spawn 按需拉起）完成。
#
# RootHide 的 dpkg 维护脚本运行在 vroot shell 中——脚本里的 "/" 就是 jbroot，
# 下面这些标准根路径会被自动映射到 <jbroot>/... ，直接用即可。
#

function finish() {
	f="${1}"
	[[ -z "${f}" || -z "${CYDIA}" ]] && return
	cydia=(${CYDIA})
	[[ ${cydia[1]} -eq 1 ]] || return
	echo "finish:${f}" >&${cydia[0]}
}

# Clear Inbox folder（jbroot 路径，vroot shell 下直接可用）
if [ -d "/var/mobile/Library/Application Support/Containers/jp.soh.reprovision.ios/Documents/Inbox" ]; then
	rm -rf "/var/mobile/Library/Application Support/Containers/jp.soh.reprovision.ios/Documents/Inbox"
fi

# 从旧版本（带 reprovisiond 守护进程或旧版 profiledaemon）升级时的兜底清理：
for c in /bin/launchctl /usr/bin/launchctl; do
	if [ -x "$c" ]; then
		for domain in "gui/501" "user/501" "system"; do
			"$c" bootout "$domain/jp.soh.reprovisiond" 2>/dev/null || true
			"$c" bootout "$domain/jp.soh.reprovision.profiledaemon" 2>/dev/null || true
			"$c" bootout "$domain/jp.soh.reprovision.signingd" 2>/dev/null || true
		done
		break
	fi
done
pkill -x reprovisiond 2>/dev/null || true
pkill -x repro-profiledaemon 2>/dev/null || true
pkill -x repro-signingd 2>/dev/null || true

# 按需 root helper：必须 root:wheel + setuid（4755），
# 否则 mobile 身份的 App 拉起它时拿不到 root。
HELPER="/usr/libexec/repro-helper"
if [ -f "$HELPER" ]; then
	chown root:wheel "$HELPER" 2>/dev/null || true
	chmod 4755 "$HELPER" 2>/dev/null || true
	echo "root helper: $(ls -l "$HELPER")"
fi

# 描述文件安装守护进程：root:wheel + 0755（不需要 setuid，launchd 已以 root 启动）
DAEMON="/usr/libexec/repro-profiledaemon"
if [ -f "$DAEMON" ]; then
	chown root:wheel "$DAEMON" 2>/dev/null || true
	chmod 0755 "$DAEMON" 2>/dev/null || true
	echo "profile daemon: $(ls -l "$DAEMON")"
fi

# IPA 导入守护进程：root:wheel + 0755（由 launchd 在系统级 rootfs 命名空间拉起，
# 负责读真实 iCloud 文件并拷到真实共享路径，绕过 App 的 jbroot overlay namespace）
IMPORTD="/usr/libexec/repro-importdaemon"
if [ -f "$IMPORTD" ]; then
	chown root:wheel "$IMPORTD" 2>/dev/null || true
	chmod 0755 "$IMPORTD" 2>/dev/null || true
	echo "import daemon: $(ls -l "$IMPORTD")"
fi

# 描述文件 IPC 共享目录：必须 mobile 可写（App 以 mobile 身份写描述文件，
# daemon 以 root 读取）。建为 mobile:mobile 0755，避免 root 创建的目录导致
# App 写入 Permission denied（这正是 v1.1.25 重签失败的根因）。
IPC_DIR="/var/mobile/Library/RePro"
mkdir -p "$IPC_DIR" 2>/dev/null || true
chown mobile:mobile "$IPC_DIR" 2>/dev/null || chmod 0777 "$IPC_DIR" 2>/dev/null || true
chmod 0755 "$IPC_DIR" 2>/dev/null || true
echo "IPC dir: $(ls -ld "$IPC_DIR" 2>/dev/null)"

ZSIGN="/usr/local/bin/zsign"
if [ -f "$ZSIGN" ]; then
	chown root:wheel "$ZSIGN" 2>/dev/null || true
	chmod 0755 "$ZSIGN" 2>/dev/null || true
fi

# App 二进制权限
APP_BIN="/Applications/RePro.app/RePro"
if [ -f "$APP_BIN" ]; then
	chmod 0755 "$APP_BIN" 2>/dev/null || true
fi

# 后台定时续签守护进程
SIGNINGD="/usr/libexec/repro-signingd"
if [ -f "$SIGNINGD" ]; then
	chown root:wheel "$SIGNINGD" 2>/dev/null || true
	chmod 0755 "$SIGNINGD" 2>/dev/null || true
	echo "signing daemon: $(ls -l "$SIGNINGD")"
fi

# 找 launchctl（signingd + profiledaemon 共用）
LAUNCHCTL=""
for c in /bin/launchctl /usr/bin/launchctl; do
	if [ -x "$c" ]; then LAUNCHCTL="$c"; break; fi
done

# v1.1.66 关键修复：RootHide 下必须用 jbroot 命令把 plist 的 jbroot 路径
# 转成 rootfs 真实路径再交给 launchctl bootstrap，否则守护进程会被 RootHide
# 当作 jbroot(namespace) 进程加载 → 私有 entitlement（如
# com.apple.backboardd.launchapplications）在运行时被剥离 →
# signingd 调 SBSLaunch 返回 7（后台拉不起 App）。参考 ReProvision-Reborn
# roothide 包 reprovisiond 的 postinst 正是这么做的。
#
# 另：daemon 的 LaunchDaemon plist 已通过 /usr/bin/env 注入
# _MSSafeMode=1/_SafeMode=1，进一步确保进程跑真实 namespace、不被 fakeroot 重定向。
JBROOT_CMD=""
for c in /usr/bin/jbroot /bin/jbroot; do
	if [ -x "$c" ]; then JBROOT_CMD="$c"; break; fi
done

# 把 jbroot 路径转成 rootfs 真实路径（无 jbroot 命令则退回原路径）
jbroot_to_rootfs() {
	local p="$1"
	if [ -n "$JBROOT_CMD" ] && [ -x "$JBROOT_CMD" ]; then
		local real=$("$JBROOT_CMD" "$p" 2>/dev/null)
		if [ -n "$real" ] && [ -f "$real" ]; then echo "$real"; return; fi
	fi
	echo "$p"
}

# 加载一个 LaunchDaemon（统一处理 jbroot→rootfs 路径转换 + bootout/bootstrap/kickstart）
load_daemon() {
	local plist="$1" label="$2" desc="$3"
	[ -n "$LAUNCHCTL" ] || { echo "WARNING: launchctl 不存在，无法加载 $desc"; return; }
	[ -f "$plist" ] || { echo "WARNING: $desc plist 不存在: $plist"; return; }

	chown root:wheel "$plist" 2>/dev/null || true
	chmod 644 "$plist" 2>/dev/null || true

	local real_plist
	real_plist=$(jbroot_to_rootfs "$plist")
	echo "Loading $desc..."
	echo "  jbroot plist = $plist"
	echo "  rootfs plist  = $real_plist"

	# v1.1.67 关键加固：从旧版本（v1.1.65 及更早，daemon 以 jbroot 路径加载）
	# 升级时，旧 daemon 仍注册在 jbroot 路径下。若只 bootout rootfs 路径，
	# 旧 daemon 会残留并继续应答 SIGHUP → 用户看到的永远是旧二进制（无新诊断行）。
	# 因此两条路径都 bootout，确保旧进程被彻底干掉，新 daemon 以 rootfs 真实路径加载。
	"$LAUNCHCTL" bootout system "$plist"     >/dev/null 2>&1 || true   # jbroot 路径（vroot shell 下即此值）
	"$LAUNCHCTL" bootout system "$real_plist" >/dev/null 2>&1 || true   # rootfs 路径
	"$LAUNCHCTL" bootout "system/$label"     >/dev/null 2>&1 || true    # 按 label 兜底

	"$LAUNCHCTL" bootstrap system "$real_plist" >/dev/null 2>&1 || "$LAUNCHCTL" load "$real_plist" >/dev/null 2>&1 || true
	"$LAUNCHCTL" kickstart -k "system/$label" >/dev/null 2>&1 || true
	echo "$desc launched"
}

# 加载 signingd LaunchDaemon（定时检查是否需要续签，通知 App）
load_daemon "/Library/LaunchDaemons/jp.soh.reprovision.signingd.plist" \
            "jp.soh.reprovision.signingd" \
            "signingd (定时续签守护进程)"

# 加载 profiledaemon LaunchDaemon（系统级上下文，不受 App namespace 影响）
load_daemon "/Library/LaunchDaemons/jp.soh.reprovision.profiledaemon.plist" \
            "jp.soh.reprovision.profiledaemon" \
            "profiledaemon (system context, outside App namespace)"

# 加载 importdaemon LaunchDaemon（系统级 rootfs 命名空间，读真实 iCloud 文件）
load_daemon "/Library/LaunchDaemons/jp.soh.reprovision.importdaemon.plist" \
            "jp.soh.reprovision.importdaemon" \
            "importdaemon (system context, reads real iCloud files)"

# Reload application cache（uicache 是 bootstrap 工具，认 jbroot 路径）
echo "Reloading application cache"
UICACHE=""
for c in /usr/bin/uicache /bin/uicache; do
	if [ -x "$c" ]; then UICACHE="$c"; break; fi
done
if [ -n "$UICACHE" ]; then
	"$UICACHE" -p "/Applications/RePro.app" 2>/dev/null || "$UICACHE" -a 2>/dev/null || true
fi

echo "Do, or do not. There is no try."
finish restart
exit 0
