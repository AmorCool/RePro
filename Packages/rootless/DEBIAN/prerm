#!/bin/bash
set -e

# ReProvision Dopamine/rootless 包 prerm

echo "[RePro] rootless prerm 开始 $(date)"

# 停止守护进程
launchctl bootout system/jp.soh.reprovisiond 2>/dev/null || true
echo "[RePro] 守护进程已停止"

# 清理残留数据
rm -rf /var/mobile/Library/Logs/RePro 2>/dev/null || true
rm -rf /var/mobile/Library/ReProvision 2>/dev/null || true
rm -f /var/mobile/Documents/ReProvisionDebug.txt 2>/dev/null || true
rm -rf /tmp/reprovision_*.log 2>/dev/null || true
echo "[RePro] 残留数据已清理"

echo "[RePro] rootless prerm 完成 $(date)"
